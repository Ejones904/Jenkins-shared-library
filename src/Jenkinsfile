#!/user/bin/env groovy
@Library('jenkins-shared-library')
def gv

pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "script.groovy"
                }
            }
        }
        stage("build jar") {
            steps {
                script {
                 buildJar()
                }
            }
        }

        stage("build and push image") {
            steps {
                script {
                def imageTag = "jma-${env.BUILD_NUMBER}"

                buildImage "ejones904/demo-app:${imageTag}"
                dockerLogin()
                dockerPush "ejones904/demo-app:${imageTag}"
                }
            }
        }

        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }
    }
}
